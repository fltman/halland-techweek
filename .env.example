# Kopiera till .env och fyll i. Filen delas av alla idéer på maskinen.

# Anthropic-nyckel för AI i apparna. Skapa en egen nyckel för workshopen, sätt ett
# utgiftstak på den och radera den efteråt.
ANTHROPIC_API_KEY=

# Valfritt: en annan Claude-modell än mallens standard (claude-opus-5-5).
AI_MODEL=

# Bara om Railway-kontot har flera workspaces (t.ex. arrangörernas): namn eller id.
RAILWAY_WORKSPACE=
