# Kopiera till .env och fyll i. Filen delas av alla idéer på maskinen.

# Nyckel för AI i apparna. Sätt ett lågt tak på den och radera den efter workshopen.
OPENROUTER_API_KEY=

# Modell på OpenRouter som /api/ai använder.
AI_MODEL=

# Bara om Railway-kontot har flera workspaces (t.ex. arrangörernas): namn eller id.
RAILWAY_WORKSPACE=
